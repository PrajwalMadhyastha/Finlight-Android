<?xml version="1.0" encoding="utf-8"?>
<!--
// =================================================================================
// FILE: ./app/src/main/res/xml/data_extraction_rules.xml
// REASON: FIX (Daily Restore) - Added an <exclude> rule for the new
// 'finlight_internal_state.xml' SharedPreferences file. This file contains a
// flag to track if the app has been launched before. Excluding it from backups
// is CRITICAL, as it ensures the "first launch" state can be reliably detected
// after a reinstall, preventing the app from restoring data every day.
// =================================================================================
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Include standard preferences -->
        <include domain="sharedpref" path="."/>
        <!-- Exclude the file with the now-unusable encrypted key -->
        <exclude domain="sharedpref" path="finlight_secure_prefs.xml" />
        <!-- Exclude the internal state file that tracks first launch -->
        <exclude domain="sharedpref" path="finlight_internal_state.xml"/>

        <!-- DO NOT include the 'database' domain for cloud backup. -->
        <!-- The restored .db file would be encrypted and unusable without the Keystore key. -->

        <!-- Include the 'file' domain, which contains backup_snapshot.gz -->
        <include domain="file" path="." />
        <!-- Exclude secure database passphrase storage file encrypted with device-bound Keystore key -->
        <exclude domain="file" path="finlight_secure.dat" />
        <!-- Exclude internal lifecycle state file so is_first_launch_complete is not preserved across devices -->
        <exclude domain="file" path="datastore/finlight_internal_state.preferences_pb" />
        <!-- Exclude large, non-essential image attachments from the backup -->
        <exclude domain="file" path="attachments/" />
    </cloud-backup>

    <device-transfer>
        <!-- Include standard preferences -->
        <include domain="sharedpref" path="."/>
        <exclude domain="sharedpref" path="finlight_secure_prefs.xml" />
        <exclude domain="sharedpref" path="finlight_internal_state.xml"/>

        <!-- DO NOT include the 'database' domain for device-to-device transfers. -->
        <!-- Android Keystore keys are hardware-bound and never transfer across devices. -->
        <!-- Database restoration is handled seamlessly via backup_snapshot.gz. -->

        <include domain="file" path="." />
        <!-- Exclude secure database passphrase storage file encrypted with device-bound Keystore key -->
        <exclude domain="file" path="finlight_secure.dat" />
        <exclude domain="file" path="datastore/finlight_internal_state.preferences_pb" />
        <exclude domain="file" path="attachments/" />
    </device-transfer>
</data-extraction-rules>