<?xml version="1.0" encoding="utf-8"?>
<!--
// =================================================================================
// FILE: ./app/src/main/res/xml/backup_rules.xml
// REASON: FIX - Added an <include> rule for the "file" domain. This is required
// for the subsequent <exclude> rule to be valid, as you can only exclude a path
// that is part of an included set. This resolves the lintVitalRelease build error.
// =================================================================================
-->
<full-backup-content>
    <!-- Include the shared preferences file -->
    <include domain="sharedpref" path="."/>
    <!-- Exclude the file with the legacy encrypted key and internal lifecycle state -->
    <exclude domain="sharedpref" path="finlight_secure_prefs.xml" />
    <exclude domain="sharedpref" path="finlight_internal_state.xml"/>

    <!-- Note: DO NOT include the 'database' domain. -->
    <!-- Android Keystore keys are hardware-bound and never transfer across devices. -->
    <!-- Database restoration is handled seamlessly via backup_snapshot.gz. -->

    <!-- Include all files in the app's internal storage directory (backup_snapshot.gz, preferences) -->
    <include domain="file" path="."/>
    <!-- Exclude secure database passphrase storage file encrypted with device-bound Keystore key -->
    <exclude domain="file" path="finlight_secure.dat" />
    <!-- Exclude large image attachments -->
    <exclude domain="file" path="attachments/" />
    <!-- Exclude internal lifecycle state file so is_first_launch_complete is not preserved across devices -->
    <exclude domain="file" path="datastore/finlight_internal_state.preferences_pb" />

</full-backup-content>
